APP_NAME="Arsanawa ERP API"
APP_ENV=production
APP_KEY=base64:<generate-with-php-artisan-key-generate-show>
APP_DEBUG=false
APP_URL=https://<railway-generated-domain>
FRONTEND_URL=https://arsanawa-erp.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.temebxcxioszcnwycwxj
DB_PASSWORD=<supabase-database-password>
DB_SSLMODE=require

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=supabase

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=lisafronaldio123@gmail.com
MAIL_PASSWORD=<gmail-app-password>
MAIL_FROM_ADDRESS=lisafronaldio123@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SCHEME=tls

SUPABASE_URL=https://temebxcxioszcnwycwxj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_STORAGE_PRODUCT_IMAGES_BUCKET=arsanawa-product-images
SUPABASE_STORAGE_IMPORTS_BUCKET=arsanawa-imports
