{
  "info": {
    "_postman_id": "2f6b2d4d-9a7a-4d2f-92f7-c5c43c0d9f8d",
    "name": "Arsanawa ERP API",
    "description": "Auto-generated Postman collection for the current Laravel API routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/api/",
      "type": "string",
      "description": "Base API URL. Keep the trailing api/ segment."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Bearer token set automatically after a successful login response."
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login response is successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('token', response.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"alice@example.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}v1/auth/login",
            "description": "POST api/v1/auth/login. Logs in with username/email and password. On success, stores access_token into collection variable token."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}v1/auth/forgot-password",
            "description": "POST api/v1/auth/forgot-password. Sends a password reset link using Laravel's password broker."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"token\": \"paste-reset-token-here\",\n  \"password\": \"new-secure-password\",\n  \"password_confirmation\": \"new-secure-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}v1/auth/reset-password",
            "description": "POST api/v1/auth/reset-password. Resets a password using email, reset token, and confirmed password."
          },
          "response": []
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}v1/auth/me",
            "description": "GET api/v1/auth/me. Requires Bearer {{token}}."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}v1/auth/logout",
            "description": "POST api/v1/auth/logout. Requires Bearer {{token}} and revokes the current access token."
          },
          "response": []
        }
      ],
      "description": "Authentication API endpoints reindexed from current Laravel routes."
    }
  ]
}
